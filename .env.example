# Link do checkout da Kiwify (os botões abrem ele com as UTMs). Vazio = botões rolam até o preço.
NEXT_PUBLIC_CHECKOUT=
NEXT_PUBLIC_SITE_URL=https://plannermentecalma.com.br
NEXT_PUBLIC_SUPORTE_EMAIL=
# Pixel: use UM dos dois. Com o da Utmify, ela dispara o da Meta (com deduplicação).
NEXT_PUBLIC_UTMIFY_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# 0 desliga o script de UTMs da Utmify
NEXT_PUBLIC_UTMIFY_UTMS=1


# Conteúdo de exemplo (criadora e depoimentos fictícios). Aparece por padrão. 0 = tira do site (OBRIGATÓRIO antes de anunciar).
NEXT_PUBLIC_MODO_TESTE=1
# Senha do painel /admin (pré-visualização do conteúdo de exemplo)
ADMIN_PASSWORD=

# ---- Entrega por e-mail (Kiwify → site → Resend) ----
# Chave da API do Resend e remetente com domínio verificado no Resend
RESEND_API_KEY=
EMAIL_FROM="Planner Mente Calma <acesso@plannermentecalma.com.br>"
# Token do webhook da Kiwify (Apps → Webhooks). URL: https://SEU-SITE/api/kiwify, evento "Compra aprovada"
KIWIFY_WEBHOOK_TOKEN=
# Segredo para assinar os links de acesso (qualquer texto longo e aleatório; não troque depois)
ENTREGA_SECRET=
# Opcional: pasta externa com os PDFs (mesmos nomes de arquivo). Vazio = pasta do próprio site.
ENTREGA_BASE_URL=

# ---- Utmify ----
# Credencial de API (Utmify → Integrações → Webhooks → Credenciais de API): o site repassa as vendas dos ORDER BUMPS.
# O produto principal chega na Utmify pela integração Kiwify → Utmify. Quem manda a compra para a Meta é a Utmify.
UTMIFY_API_TOKEN=
# 1 = vendas repassadas aparecem como teste na Utmify (só para testar)
UTMIFY_TEST=
